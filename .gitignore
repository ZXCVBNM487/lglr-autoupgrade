# ===== 构建 / 打包产物（体积大、非源码，禁止入库）=====
build/
dist/
__pycache__/
*.spec.bak

# ===== 运行日志（可能含设备序列号 / 个人信息）=====
*.log
logs/

# ===== 调试截图（可能含游戏账号 / 设备信息）=====
# 根目录 PNG 一律不入库；脱敏展示图只在 docs/screenshots/ 与 refs/
/*.png
*_shots/
survey_shots/

# ===== 真实配置（含本机路径，且未来可能填入 QQ / 邮箱凭据）=====
config.json

# ===== 运行时产物 / 诊断输出 =====
state.json
gui_err.txt
.run_lock
_*.txt
_*.py
diag_times.py

# 以下保留入库：refs/ 参考图标、源码 .py、tests/、README.md、docs/、
# config.example.json、profiles.example.json、tester.spec、build_exe.bat、3_停止全部.bat
